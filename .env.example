# --- Public, shipped to the browser --------------------------------
# Sanity project that holds properties and journal posts.
# Find the project id at https://sanity.io/manage
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# --- Server only, NEVER prefixed with VITE_ ------------------------
# Used by api/submit-property.js to file client submissions as drafts.
# Create at sanity.io/manage -> API -> Tokens, with "Editor" permission.
# Set this in your host's environment settings (Vercel/Netlify), not here.
SANITY_WRITE_TOKEN=
